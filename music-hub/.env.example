# Spelunke — copy to `.env` and fill in.
# One shared (grandfathered) Spotify app; every user authorizes against it.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# OAuth redirect URI. Register the EXACT value you use in the Spotify app.
#   - Local dev (loopback is the only allowed http://):
#       SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/hub/services/spotify/callback
#   - Server behind Caddy (real HTTPS):
#       SPOTIFY_REDIRECT_URI=https://hub.zukkafabrik.de/api/hub/services/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/hub/services/spotify/callback

# HTTP server
HUB_HOST=0.0.0.0
HUB_PORT=8080

# SQLite database
HUB_DATABASE_URL=sqlite:hub.db

# Tonies integration (#499).
# HUB_TONIES_SECRET_KEY encrypts the Tonies refresh token at rest (AES-256-GCM).
# Generate a long random value and NEVER commit it:
#   HUB_TONIES_SECRET_KEY=$(head -c32 /dev/urandom | base64)
HUB_TONIES_SECRET_KEY=
# Overridable bases (defaults point at the real Tonies services):
# TONIES_AUTH_BASE=https://login.tonies.com/auth
# TONIES_API_BASE=https://api.tonies.com
