[Unit]
Description=music-hub: main -> prod (fetch, build, restart, health gate)
Documentation=https://github.com/momokli/momos-music-manager/blob/main/music-hub/deploy/continuous-deploy.sh
After=network-online.target music-hub.service
Wants=network-online.target

[Service]
Type=oneshot
User=momo
Group=momo
Environment=HOME=/home/momo
ExecStart=/home/momo/music-hub/deploy/continuous-deploy.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=900
