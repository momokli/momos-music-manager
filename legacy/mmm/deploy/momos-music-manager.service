[Unit]
Description=Momo's Music Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=momo

# ── Environment ──────────────────────────────────────────────────
# Secrets go in a drop-in override:
#   sudo systemctl edit momos-music-manager
Environment="DATABASE_URL=sqlite:///home/momo/momos-music-manager/data/library.db"
Environment="RUST_LOG=info"
Environment="MOMOS_MAINTAINER_INTERVAL_SECS=3600"
Environment="PUBLIC_URL=https://music.klimk.es"

# DB file must exist before the Rust binary can open it.
# (Prefixed with '-' to tolerate failure if DB already exists.)
ExecStartPre=-/bin/bash -c 'sudo -u momo sqlite3 /home/momo/momos-music-manager/data/library.db "VACUUM" 2>/dev/null'

ExecStart=/home/momo/momos-music-manager/target/release/momos-music-manager serve \
    --host 0.0.0.0 \
    --port 3000

Restart=always
RestartSec=10
TimeoutStartSec=120

# ═══ SECRETS — set these in an override file ═══
# sudo systemctl edit momos-music-manager
#   [Service]
#   Environment="SPOTIFY_CLIENT_ID=..."
#   Environment="SPOTIFY_CLIENT_SECRET=..."
#   Environment="SPOTIFY_REDIRECT_URI=https://music.klimk.es/callback"
#   Environment="SOUNDCLOUD_API_KEY=..."

[Install]
WantedBy=multi-user.target
