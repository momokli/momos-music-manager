# music-api configuration. Copy to /opt/music-api/music-api.env (chmod 600).

# Shared bearer token. REQUIRED. Generate with: openssl rand -hex 32
MUSIC_API_TOKEN=change-me

# HTTP bind address (behind Caddy; Caddy never exposes this directly).
MUSIC_API_BIND=0.0.0.0:8710

# Deezer ARL used for native downloads. REQUIRED for downloads; leave empty to
# run the API without downloading. Never logged. (The pre-0.6 variable name is
# still accepted as a fallback with a one-time warning.)
DEEZER_ARL=

# Requested download quality: flac | mp3-320 | mp3-128. Default: flac.
# The tier fallback steps down FLAC → 320 → 128 when the ARL's account cannot
# stream the wanted tier.
DOWNLOAD_QUALITY=flac

# Our store: flac/ 320/ 128/ live here. Put this on the BIG volume — a full
# library is hundreds of GB, which will not fit on a small root filesystem.
DATA_DIR=/data/public/media/music-api

# The ledger DB is small; keep it wherever is convenient.
DATABASE_URL=sqlite:/opt/music-api/data/music-api.db

# Deezer public API (no auth needed for ISRC lookups).
DEEZER_BASE=https://api.deezer.com
# Deezer gw-light endpoint for the ARL tier probe (`GET /account`).
DEEZER_GW_BASE=https://www.deezer.com/ajax/gw-light.php

FFMPEG=ffmpeg
FFPROBE=ffprobe
WORKER_INTERVAL_SECS=5
DOWNLOAD_TIMEOUT_SECS=900

# Max downloads dispatched at once (in-flight cap). Orders are still accepted
# without limit; the priority queue fills these slots as they free up.
MAX_INFLIGHT=5

# BPM/key analysis (Essentia); unset/blank disables it.
# ANALYZER_URL=http://127.0.0.1:8711

# RUST_LOG=info
