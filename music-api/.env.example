# music-api configuration. Copy to /opt/music-api/music-api.env (chmod 600).

# Shared bearer token. REQUIRED. Generate with: openssl rand -hex 32
MUSIC_API_TOKEN=change-me

# HTTP bind address (behind Caddy; Caddy never exposes this directly).
MUSIC_API_BIND=0.0.0.0:8710

# Dedicated deemix instance used for downloads (see deploy/deemix-api.compose.yml).
DEEMIX_URL=http://127.0.0.1:6599
# Deezer ARL. REQUIRED for downloads; leave empty to run the API without a worker.
DEEMIX_ARL=

# Requested deemix bitrate: 1 = 128, 3 = 320, 9 = FLAC.
DEEMIX_BITRATE=9

# Where deemix writes (its /downloads, mounted below our data dir).
DEEMIX_DOWNLOAD_DIR=/data/public/media/music-api/incoming

# Our store: flac/ 320/ 128/ live here. Put this on the BIG volume — a full
# library is hundreds of GB, which will not fit on a small root filesystem.
DATA_DIR=/data/public/media/music-api

# The ledger DB is small; keep it wherever is convenient.
DATABASE_URL=sqlite:/opt/music-api/data/music-api.db

# Deezer public API (no auth needed for ISRC lookups).
DEEZER_BASE=https://api.deezer.com

FFMPEG=ffmpeg
FFPROBE=ffprobe
WORKER_INTERVAL_SECS=5
DOWNLOAD_TIMEOUT_SECS=900

# RUST_LOG=info
