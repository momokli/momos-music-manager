# Tonies-Hub — copy to .env and fill in. Never commit real secrets.

# HTTP listener
TONIES_HOST=0.0.0.0
TONIES_PORT=8090

# SQLite database (own DB — never the music hub's hub.db)
TONIES_DATABASE_URL=sqlite:tonies.db

# Music API (env wins over the settings table; DB is only a fallback)
MUSIC_API_BASE=http://127.0.0.1:8710
MUSIC_API_TOKEN=
# Tonies Keycloak client id
TONIES_CLIENT_ID=

# Set to 1 behind HTTPS so the session cookie gets the Secure flag.
TONIES_COOKIE_SECURE=0
