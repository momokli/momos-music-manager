# Spotify Mirror Environment Configuration
# Copy this file to .env and fill in the values
# ====================================================

# Spotify API Credentials
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# Server Configuration
HOST=0.0.0.0
PORT=3000

# Database Configuration
DATABASE_URL=sqlite:./app.db

# Logging Configuration
RUST_LOG=info

# Autoupdater (M6) — optional overrides
# The default base URL is channel-dependent: dev builds track the rolling
# `latest-main` release, release builds track `releases/latest` (newest
# semver release). Set MOMOS_AUTOUPDATE_BASE_URL only to override the
# channel default (see docs/versioning.md).
# MOMOS_AUTOUPDATE_ENABLED=true
# MOMOS_AUTOUPDATE_CHANNEL=release|rolling
#   (default: channel of the running build — dev build → rolling,
#    release build → release; overridable in the Settings page too)
# MOMOS_AUTOUPDATE_BASE_URL=https://github.com/momokli/momos-music-manager/releases/download/latest-main
# MOMOS_AUTOUPDATE_HEALTH_GRACE_SECS=60
