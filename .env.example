# Spotify Mirror Environment Configuration
# Copy this file to .env and fill in the values
# ====================================================

# Spotify API Credentials
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# Server Configuration
HOST=0.0.0.0
PORT=3000

# Database Configuration
DATABASE_URL=sqlite:./app.db

# Logging Configuration
RUST_LOG=info

# Autoupdater (M6) — optional overrides
# The default base URL is channel-dependent: dev builds track the rolling
# `latest-main` release, release builds track `releases/latest` (newest
# semver release). Set MOMOS_AUTOUPDATE_BASE_URL only to override the
# channel default (see docs/versioning.md).
# MOMOS_AUTOUPDATE_ENABLED=true
# MOMOS_AUTOUPDATE_CHANNEL=release|rolling
#   (default: channel of the running build — dev build → rolling,
#    release build → release; overridable in the Settings page too)
# MOMOS_AUTOUPDATE_BASE_URL=https://github.com/momokli/momos-music-manager/releases/download/latest-main
# MOMOS_AUTOUPDATE_HEALTH_GRACE_SECS=60

# Telemetry (event push) — optional overrides
# Event telemetry is OFF unless [telemetry] enabled = true is set in
# config.toml (or MOMOS_TELEMETRY_ENABLED=true).
# MOMOS_TELEMETRY_ENABLED=false
# Where event batches are POSTed (default: <telemetry.base_url>/api/telemetry).
# MOMOS_TELEMETRY_EVENTS_ENDPOINT=https://telemetry.example.com/api/telemetry
# MOMOS_TELEMETRY_BASE_URL=https://telemetry.example.com
# MOMOS_TELEMETRY_TOKEN=secret-collector-token

# Telemetry receiver (collector) — optional overrides
# MOMOS_TELEMETRY_RECEIVER_BIND=127.0.0.1:8330
# MOMOS_TELEMETRY_RECEIVER_BASE_DIR=~/.local/share/momos-music-manager/analytics
# Event telemetry.db (default: <base_dir>/telemetry.db) + retention in days.
# MOMOS_TELEMETRY_RECEIVER_DB_PATH=~/.local/share/momos-music-manager/analytics/telemetry.db
# MOMOS_TELEMETRY_RECEIVER_RETENTION_DAYS=30
# MOMOS_TELEMETRY_RECEIVER_TOKEN=secret-collector-token
