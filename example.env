# Momo's Music Manager - Environment Configuration
# Copy this file to `.env` and fill in your actual credentials

# ============================================================================
# SPOTIFY CONFIGURATION (Required for Spotify integration)
# ============================================================================

# Get these from Spotify Developer Dashboard: https://developer.spotify.com/dashboard
# Create an app and add redirect URI: http://127.0.0.1:3000/callback (or http://localhost:3000/callback)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# ============================================================================
# SOUNDCLOUD CONFIGURATION (Required for SoundCloud integration)
# ============================================================================

# Get API key from SoundCloud Developer portal
# Optional user ID for personal playlists
SOUNDCLOUD_API_KEY=your_soundcloud_api_key_here
SOUNDCLOUD_USER_ID=optional_soundcloud_user_id

# ============================================================================
# YOUTUBE CONFIGURATION (Required for YouTube integration)
# ============================================================================

# Get API key from Google Cloud Console (YouTube Data API v3)
# Optional playlist ID for syncing specific playlists
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_PLAYLIST_ID=optional_youtube_playlist_id

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Database configuration
DATABASE_URL=sqlite:///app/data/app.db

# Logging level (debug, info, warn, error)
RUST_LOG=info

# Server binding address
HOST=0.0.0.0
PORT=3000

# ============================================================================
# DOCKER COMPOSE OVERRIDES (optional)
# ============================================================================

# For Docker Compose, these can be set in docker-compose.yml
# SPOTIFY_CLIENT_ID=${SPOTIFY_CLIENT_ID:-}
# SPOTIFY_CLIENT_SECRET=${SPOTIFY_CLIENT_SECRET:-}
# SPOTIFY_REDIRECT_URI=${SPOTIFY_REDIRECT_URI:-http://127.0.0.1:3000/callback}

# ============================================================================
# NOTES
# ============================================================================

# 1. This file (.env) is the ONLY source for service credentials
# 2. Credentials are NEVER stored in the database
# 3. UI shows "Configured" when these environment variables are set
# 4. Restart the backend after modifying this file
# 5. Keep this file secure - never commit it to version control
